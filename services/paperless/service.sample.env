# Environment variables of Paperless, given to its container.
# Your copy of this file is services/paperless/custom/service.env: it is created when the service is enabled.
# Variables which are commented are optional: uncomment them to use them.

PAPERLESS_SECRET_KEY=changeme
# list of language codes here: https://packages.debian.org/search?keywords=tesseract-ocr-&searchon=names&suite=buster
PAPERLESS_OCR_LANGUAGE=eng,fra
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_MAIL=yourmail@domain.com
PAPERLESS_ADMIN_PASSWORD=changeme
# Prevent errors when importing PDF files with digital signatures
PAPERLESS_OCR_USER_ARGS="{\"invalidate_digital_signatures\": true}"
