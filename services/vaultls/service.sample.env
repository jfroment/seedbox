# Environment variables of VaulTLS, given to its container.
# Your copy of this file is services/vaultls/custom/service.env: it is created when the service is enabled.
# Variables which are commented are optional: uncomment them to use them.

# Secret of the API: generate it with "openssl rand -base64 32"
VAULTLS_API_SECRET=changeme

# Encrypt the database. Warning: this cannot be undone, and the secret must never be lost
# VAULTLS_DB_SECRET=changeme
# error, warn, info, debug or trace
# VAULTLS_LOG_LEVEL=info
