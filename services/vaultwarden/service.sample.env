# Environment variables of Vaultwarden, given to its container.
# Your copy of this file is services/vaultwarden/custom/service.env: it is created when the service is enabled.
# Variables which are commented are optional: uncomment them to use them.

# ADMIN_TOKEN=changeme
# SMTP_HOST=changeme
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=changeme
# SMTP_USERNAME=changeme
# SMTP_PASSWORD=changeme
