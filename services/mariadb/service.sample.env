# Environment variables of MariaDB (database of Nextcloud), given to its container.
# Your copy of this file is services/mariadb/custom/service.env: it is created when the service is enabled.
# Variables which are commented are optional: uncomment them to use them.

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=changeme
