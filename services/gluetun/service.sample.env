# Environment variables of Gluetun (VPN client), given to its container.
# Your copy of this file is services/gluetun/custom/service.env: it is created when the service is enabled.
# Variables which are commented are optional: uncomment them to use them.

# Default mode: Wireguard custom endpoint. For another provider, see doc/configuration.md#vpn
# and https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard

# Wireguard endpoint
VPN_ENDPOINT_IP=changeme
VPN_ENDPOINT_PORT=51820
WIREGUARD_PUBLIC_KEY=changeme
WIREGUARD_PRIVATE_KEY=changeme
# Wireguard LAN address
WIREGUARD_ADDRESSES=changeme
# WIREGUARD_PRESHARED_KEY=changeme
